{
  "name": "symphony-desktop-workspace",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @symphony/desktop dev",
    "build:desktop": "pnpm --filter @symphony/desktop build",
    "dev:mobile": "pnpm --filter @symphony/mobile dev",
    "build:mobile": "pnpm --filter @symphony/mobile build",
    "generate:api": "node scripts/generate-api.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^7.0.2"
  }
}
