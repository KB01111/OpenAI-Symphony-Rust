{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Symphony Desktop",
  "version": "1.0.0",
  "identifier": "com.openai.symphony.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @symphony/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @symphony/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Symphony Desktop — AI Coding Orchestration Platform",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
