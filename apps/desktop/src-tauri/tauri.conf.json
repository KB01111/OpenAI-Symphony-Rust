{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Symphony Desktop",
  "version": "2.0.0",
  "identifier": "io.github.kb01111.symphony-desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @symphony/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @symphony/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Symphony Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:*",
        "object-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNzlEQjA1MjBFMkUxRTUKUldUbDRlSWdCZHQ1RVg1eHg5cXpPd3RWNzIxM1pHWU1IWDFjZC9RbnVGeFIrYzFFS2ZPMmZqTjMK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Symphony Desktop Contributors",
    "copyright": "Copyright (c) Symphony Desktop Contributors. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Autonomous coding orchestration for Windows 11",
    "longDescription": "Symphony Desktop schedules coding agents (Codex, Claude Code, OpenCode) against GitHub and Linear issues in isolated Git worktrees, with approvals, validation and merge readiness checks.",
    "homepage": "https://github.com/KB01111/OpenAI-Symphony-Rust",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Swedish"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Symphony Desktop",
        "compression": "lzma"
      }
    },
    "license": "MIT",
    "licenseFile": "../../../LICENSE"
  }
}
