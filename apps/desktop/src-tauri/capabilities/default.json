{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: runtime discovery, scoped native integrations, and window controls only. No shell, filesystem, or arbitrary command access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-local-api-config",
    "allow-open-task-workspace",
    "allow-pick-repository-folder",
    "allow-set-autostart",
    "allow-exit-application",
    "allow-set-native-locale",
    "allow-open-data-directory",
    "allow-open-log-directory",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-open-releases-page"
  ]
}
